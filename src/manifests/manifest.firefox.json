{
  "manifest_version": 3,
  "name": "Privly",
  "description": "Azure PIM and Entra role management in your browser",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "scripts": ["background/index.js"]
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "permissions": [
    "identity",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://graph.microsoft.com/*",
    "https://login.microsoftonline.com/*",
    "https://login.microsoftonline.us/*",
    "https://graph.microsoft.us/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "privly@addons.tripointlabs.com",
      "strict_min_version": "128.0"
    }
  }
}
